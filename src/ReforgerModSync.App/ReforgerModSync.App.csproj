<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\ReforgerModSync.Core\ReforgerModSync.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>ReforgerModSync.App</RootNamespace>
    <AssemblyName>ReforgerSyncLaunch</AssemblyName>
    <Product>Reforger Sync &amp; Launch</Product>
    <AssemblyTitle>Reforger Sync &amp; Launch</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Halbiert die EXE, der Start dauert rund 0,1 Sekunden länger. Die App ist nur auf Deutsch. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <!-- WPF0001: Das Windows-11-Design (ThemeMode) ist als experimentell markiert. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
</Project>
