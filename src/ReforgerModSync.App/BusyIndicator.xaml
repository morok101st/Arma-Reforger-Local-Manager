<UserControl x:Class="ReforgerModSync.App.BusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="18"
             Focusable="False" IsHitTestVisible="False">
    <UserControl.Resources>
        <Style TargetType="Rectangle">
            <Setter Property="Width" Value="4" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
            <Setter Property="Fill" Value="{StaticResource BrandGoldBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
        <QuadraticEase x:Key="Wave" EasingMode="EaseInOut" />
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Bar1Scale" Storyboard.TargetProperty="ScaleY"
                                     From="0.3" To="1" Duration="0:0:0.4" AutoReverse="True" EasingFunction="{StaticResource Wave}" />
                    <DoubleAnimation Storyboard.TargetName="Bar2Scale" Storyboard.TargetProperty="ScaleY"
                                     BeginTime="0:0:0.15" From="0.3" To="1" Duration="0:0:0.4" AutoReverse="True" EasingFunction="{StaticResource Wave}" />
                    <DoubleAnimation Storyboard.TargetName="Bar3Scale" Storyboard.TargetProperty="ScaleY"
                                     BeginTime="0:0:0.3" From="0.3" To="1" Duration="0:0:0.4" AutoReverse="True" EasingFunction="{StaticResource Wave}" />
                    <!-- Kurze Pause, damit die Welle sichtbar von vorn beginnt -->
                    <DoubleAnimation Storyboard.TargetName="Bar1Scale" Storyboard.TargetProperty="ScaleY"
                                     BeginTime="0:0:0.8" To="0.3" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid>
        <Rectangle HorizontalAlignment="Left">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar1Scale" ScaleY="0.3" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle HorizontalAlignment="Center">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar2Scale" ScaleY="0.3" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle HorizontalAlignment="Right">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar3Scale" ScaleY="0.3" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
