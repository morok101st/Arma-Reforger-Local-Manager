<Application x:Class="ReforgerModSync.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <!-- Farben der App: dunkle Flächen, Gold als Akzent -->
        <Color x:Key="BrandGold">#FFC720</Color>
        <Color x:Key="BrandGoldLight">#FFDA66</Color>
        <Color x:Key="BrandGoldDark">#E3AC00</Color>
        <Color x:Key="BrandBackground">#141414</Color>
        <Color x:Key="BrandSurface">#1F1F1F</Color>
        <Color x:Key="BrandSurfaceRaised">#2E2E2E</Color>
        <Color x:Key="BrandBorder">#3B3B3B</Color>
        <Color x:Key="BrandMuted">#B8B8B8</Color>

        <SolidColorBrush x:Key="BrandGoldBrush" Color="{StaticResource BrandGold}" />
        <SolidColorBrush x:Key="BrandBackgroundBrush" Color="{StaticResource BrandBackground}" />
        <SolidColorBrush x:Key="BrandSurfaceBrush" Color="{StaticResource BrandSurface}" />
        <SolidColorBrush x:Key="BrandSurfaceRaisedBrush" Color="{StaticResource BrandSurfaceRaised}" />
        <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorder}" />
        <SolidColorBrush x:Key="BrandMutedBrush" Color="{StaticResource BrandMuted}" />
        <SolidColorBrush x:Key="BrandDangerBrush" Color="#EF4444" />

        <!-- Auswahl: dunkles Gold, damit weißer Text gut lesbar bleibt -->
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#5C4A0C" />
        <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5C4A0C" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#5C4A0C" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
        <Color x:Key="{x:Static SystemColors.HighlightColorKey}">#5C4A0C</Color>

        <!-- Akzentfarbe des Windows-Designs durch das Gold der App ersetzen -->
        <Color x:Key="SystemAccentColor">#FFC720</Color>
        <Color x:Key="SystemAccentColorLight1">#FFCE3A</Color>
        <Color x:Key="SystemAccentColorLight2">#FFDA66</Color>
        <Color x:Key="SystemAccentColorLight3">#FFE79C</Color>
        <Color x:Key="SystemAccentColorDark1">#E3AC00</Color>
        <Color x:Key="SystemAccentColorDark2">#C99900</Color>
        <Color x:Key="SystemAccentColorDark3">#A87F00</Color>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFC720" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFCE3A" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#E3AC00" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFDA66" />
        <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFC720" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#141414" />
        <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#2E2E2E" />
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFC720" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFCE3A" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E3AC00" />
        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#3B3B3B" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#141414" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#141414" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#2E2E2E" />
        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#828282" />
        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#E3AC00" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#E3AC00" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#C99900" />
        <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#E3AC00" />
        <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#FFC720" />
        <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#FFC720" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFC720" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#3B3B3B" />
        <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#C99900" />
        <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFC720" />
        <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3B3B3B" />
        <SolidColorBrush x:Key="ProgressBarForeground" Color="#FFC720" />
        <SolidColorBrush x:Key="ProgressBarIndeterminateForeground" Color="#FFC720" />
    </Application.Resources>
</Application>
