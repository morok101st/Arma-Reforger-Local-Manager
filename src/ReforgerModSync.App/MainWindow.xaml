<Window x:Class="ReforgerModSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReforgerModSync.App"
        Title="101st Server Manager"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BrandBackgroundBrush}"
        Width="1080" Height="830" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:AttentionBorderConverter x:Key="AttentionBorder" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrandMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Message" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrandDangerBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <!-- Der Inhalt des Reiters erbt diese Farbe. -->
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Farbe nur an der Beschriftung setzen: Am TabItem würde sie auf den Inhalt des Reiters abfärben. -->
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" Padding="14,8" Margin="0,0,4,0">
                            <ContentPresenter x:Name="Label" ContentSource="Header" RecognizesAccessKey="True"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource BrandMutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="White" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource BrandGoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="3,0,0,0" CornerRadius="3" Padding="12,8" Margin="0,0,0,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource BrandSurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource BrandSurfaceRaisedBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BrandGoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Marke und Server-Liste, gelten für Übersicht und Einstellungen -->
        <Border Background="{StaticResource BrandSurfaceBrush}" BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="2,2,0,18">
                    <Image Source="pack://application:,,,/Assets/logo.png" Height="50" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="101st" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandGoldBrush}" />
                        <TextBlock Text="Server Manager" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Server" FontWeight="SemiBold" Foreground="{StaticResource BrandMutedBrush}" Margin="4,0,0,8" />

                <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                         ItemContainerStyle="{StaticResource ServerItem}"
                         Background="Transparent" BorderThickness="0"
                         IsEnabled="{Binding IsNotBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ListStatus}" Foreground="{StaticResource BrandMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="0,10,0,0" IsEnabled="{Binding IsNotBusy}">
                    <Button x:Name="AddServerButton" Content="Server hinzufügen" Command="{Binding AddProfileCommand}"
                            HorizontalAlignment="Stretch" Padding="8,7" />
                    <Button Content="Server entfernen" Click="OnRemoveProfileClick"
                            HorizontalAlignment="Stretch" Padding="8,7" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTab}" Margin="12" Background="Transparent">
            <TabItem Header="Übersicht">
                <Grid Margin="16" DataContext="{Binding SelectedProfile}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitle}" FontSize="24" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Hint}">
                        <Run Text="Adresse:" /> <Run Text="{Binding ServerAddress, Mode=OneWay}" />
                        <Run Text="  ·  Zielordner:" /> <Run Text="{Binding DownloadDirDisplay, Mode=OneWay}" />
                        <Run Text="  ·  " /> <Run Text="{Binding ListStand, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />

                    <!-- Links die Verwaltung, neutral. Rechts die Hauptaktion für Spieler. -->
                    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Padding="16,8"
                                Content="{Binding DataContext.SyncButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding DataContext.SyncCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                BorderBrush="{Binding HasOpenMods, Converter={StaticResource AttentionBorder}}" />
                        <Button DockPanel.Dock="Left" Content="Neu prüfen" Margin="8,0,0,0" Padding="14,8"
                                Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button DockPanel.Dock="Right" Content="Direkt beitreten" Margin="8,0,0,0" Padding="20,8" Click="OnJoinServerClick"
                                Style="{DynamicResource AccentButtonStyle}" FontWeight="SemiBold"
                                IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Startet Arma Reforger und tritt diesem Server direkt bei" />
                    </DockPanel>

                    <ProgressBar Grid.Row="4" Height="6" Margin="0,12,0,0"
                                 Foreground="{StaticResource BrandGoldBrush}"
                                 Maximum="{Binding ProgressTotal}" Value="{Binding ProgressDone}" />

                    <DockPanel Grid.Row="5" Margin="0,10,0,10">
                        <local:BusyIndicator DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top"
                                             Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Message}"
                                   Text="{Binding StatusMessage}" Tag="{Binding StatusIsError}" />
                    </DockPanel>

                    <DataGrid Grid.Row="6" ItemsSource="{Binding Mods}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{StaticResource BrandSurfaceBrush}"
                              HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Benötigt" Binding="{Binding Required}" Width="100" />
                            <DataGridTextColumn Header="Lokal" Binding="{Binding Local}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrandGoldBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrandDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Expander Grid.Row="7" Header="Protokoll" Margin="0,10,0,0">
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="130" Margin="0,6,0,0"
                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextChanged="OnLogChanged" />
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Einstellungen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" HorizontalAlignment="Left" Width="640" DataContext="{Binding SelectedProfile}">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Frei wählbar, zum Beispiel „Training“ oder „Event-Server“." Style="{StaticResource Hint}" />

                        <TextBlock Text="Spielserver" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
                        <TextBlock Text="Server-Adresse" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="IP und Port, zum Beispiel 203.0.113.10:2001. Von diesem Server kommt die Mod-Liste, der Server muss dafür laufen." Style="{StaticResource Hint}" />

                        <TextBlock Text="Server-Passwort" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordInput" />
                        <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Hint}" />

                        <TextBlock Text="Download" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
                        <TextBlock Text="Zielordner" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DownloadDir, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Durchsuchen …" Margin="8,0,0,0" Click="OnBrowseClick" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Leer lassen, um den Standardordner des Spiels zu nutzen. Mehrere Server können denselben Ordner teilen, gemeinsame Mods werden dann nur einmal geladen." />

                        <StackPanel Visibility="{Binding HasDownloadDir, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Über „Direkt beitreten“ in der Übersicht nutzt das Spiel diesen Ordner automatisch. Nur wenn du lieber direkt über Steam startest, trage diesen Text dort ein: Arma Reforger › Eigenschaften › Startoptionen. Sonst lädt das Spiel beim Beitritt alles erneut." />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SteamLaunchOptions, Mode=OneWay}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Kopieren" Margin="8,0,0,0" Click="OnCopyLaunchOptionsClick" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0"
                                    IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button Content="Speichern und Server prüfen" Click="OnSaveClick"
                                    Style="{DynamicResource AccentButtonStyle}" FontWeight="SemiBold" Padding="20,8" />
                            <Button Content="Gespeichertes Passwort löschen" Click="OnDeletePasswordClick" Margin="8,0,0,0" Padding="14,8" />
                        </StackPanel>
                        <DockPanel Margin="0,12,0,0">
                            <local:BusyIndicator DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top"
                                                 Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Message}"
                                       Text="{Binding SettingsMessage}" Tag="{Binding SettingsMessageIsError}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
