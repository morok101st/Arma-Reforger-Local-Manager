<Window x:Class="ReforgerModSync.App.BasicSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grundeinstellungen"
        Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BrandSurfaceBrush}" Foreground="White"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="OnDragWindow">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrandMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Nur sichtbar, wenn es etwas zu melden gibt. -->
        <Style x:Key="Error" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrandDangerBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="110" />
            <Setter Property="MaxLength" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <EventSetter Event="PreviewTextInput" Handler="OnNumberTextInput" />
            <EventSetter Event="DataObject.Pasting" Handler="OnNumberPasting" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BrandBorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource BrandGoldBrush}" />
            <StackPanel Margin="24,20,24,20">
                <TextBlock Text="Grundeinstellungen" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Gelten für alle Server. Die Standardwerte passen in den meisten Fällen." />

                <TextBlock Text="Arma Reforger" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Spielclient (ArmaReforgerSteam.exe)" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExeInput" Text="{Binding ReforgerExe, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Spielclient" />
                    <Button Grid.Column="1" Content="Durchsuchen …" Margin="8,0,0,0" Click="OnBrowseClick" />
                </Grid>
                <TextBlock Text="{Binding ReforgerExeError}" Style="{StaticResource Error}" />
                <TextBlock Text="{Binding DetectedExeHint}" Style="{StaticResource Hint}" />

                <TextBlock Text="Spielfenster beim Sync" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Breite × Höhe in Pixeln" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Number}"
                             AutomationProperties.Name="Breite" />
                    <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource BrandMutedBrush}" />
                    <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Number}"
                             AutomationProperties.Name="Höhe" />
                </StackPanel>
                <TextBlock Text="{Binding WindowError}" Style="{StaticResource Error}" />
                <TextBlock Text="Max. Bilder pro Sekunde" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding MaxFps, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Number}"
                         AutomationProperties.Name="Max. Bilder pro Sekunde" />
                <TextBlock Text="{Binding MaxFpsError}" Style="{StaticResource Error}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Das Fenster bleibt beim Sync ausgeblendet. Kleine Werte schonen den Rechner." />

                <TextBlock Text="Zeitlimits" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Höchstdauer eines Syncs in Minuten" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding TotalMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Number}"
                         AutomationProperties.Name="Höchstdauer eines Syncs" />
                <TextBlock Text="{Binding TotalMinutesError}" Style="{StaticResource Error}" />
                <TextBlock Text="Neustart ohne Fortschritt nach Minuten" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding IdleMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Number}"
                         AutomationProperties.Name="Neustart ohne Fortschritt nach" />
                <TextBlock Text="{Binding IdleMinutesError}" Style="{StaticResource Error}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Kommt so lange kein Fortschritt, startet der Spielclient einmal neu. Bereits geladene Mods bleiben erhalten." />

                <TextBlock Text="{Binding SaveError}" Style="{StaticResource Error}" Margin="0,16,0,0" />

                <DockPanel Margin="0,22,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="Standard wiederherstellen" Padding="14,8" Click="OnResetClick" />
                    <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Speichern" Margin="8,0,0,0" Padding="18,8" MinWidth="100"
                            Style="{DynamicResource AccentButtonStyle}" FontWeight="SemiBold" Click="OnSaveClick" />
                    <Button DockPanel.Dock="Right" Content="Abbrechen" IsCancel="True" Padding="18,8" MinWidth="100" />
                </DockPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
