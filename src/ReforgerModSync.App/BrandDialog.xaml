<Window x:Class="ReforgerModSync.App.BrandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync &amp; Launch"
        Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BrandSurfaceBrush}" Foreground="White"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="OnDragWindow">
    <Border BorderBrush="{StaticResource BrandGoldBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource BrandGoldBrush}" />
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.RowSpan="2" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Foreground="{StaticResource BrandGoldBrush}" Margin="0,2,16,0" VerticalAlignment="Top" />
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Grid.Column="1" Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource BrandMutedBrush}" LineHeight="20" />

                <StackPanel Grid.ColumnSpan="2" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelButton" Content="Abbrechen" IsCancel="True" Padding="18,8" MinWidth="100" />
                    <Button x:Name="ConfirmButton" Margin="8,0,0,0" Padding="18,8" MinWidth="100" Click="OnConfirm" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
