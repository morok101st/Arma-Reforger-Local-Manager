{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reforger Sync & Launch",
  "mainBinaryName": "ReforgerSyncLaunch",
  "identifier": "de.morok.reforgersynclaunch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Reforger Sync & Launch",
        "width": 1080,
        "height": 830,
        "minWidth": 820,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Morok",
    "homepage": "https://github.com/morok101st/Arma-Reforger-Local-Manager",
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../helper/": "helper/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFMTA4RTkxNEE5RTcwMkUKUldRdWNKNUtrWTRRVGsrRGFsOFNpZHNFV0g0UGd6ekUyWEdISlh2OGlEMEVRR3N3WVE4R3Exb3IK",
      "endpoints": [
        "https://github.com/morok101st/Arma-Reforger-Local-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
