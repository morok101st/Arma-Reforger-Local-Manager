{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reforger Sync & Launch",
  "mainBinaryName": "ReforgerSyncLaunch",
  "identifier": "de.morok.reforgersynclaunch.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Reforger Sync & Launch",
        "width": 1080,
        "height": 830,
        "minWidth": 820,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
